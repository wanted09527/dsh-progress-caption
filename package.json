{
  "name": "dsh-progress-caption",
  "version": "0.1.0",
  "description": "DSH 客户端插件：在输入框上方显示当前思考到第几步、在干什么、成没成；纯本机规则推断，不调模型、不发网络请求。 A DSH client plugin that captions the thinking phase with step, action and outcome.",
  "author": "陈雅儒",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "deepseek-harness",
    "web-ui",
    "progress",
    "caption",
    "thinking",
    "reasoning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR-GITHUB-USERNAME/dsh-progress-caption.git"
  },
  "homepage": "https://github.com/YOUR-GITHUB-USERNAME/dsh-progress-caption#readme",
  "bugs": {
    "url": "https://github.com/YOUR-GITHUB-USERNAME/dsh-progress-caption/issues"
  },
  "type": "module",
  "scripts": {
    "test": "node test/render.test.mjs && node test/package.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
